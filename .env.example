# Copy to .env (repo root) and fill in. Never commit .env.

# ---- Model ----
LLM_BACKEND=fake                  # fake (offline keyword fallback) | ollama (Gemma 4)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b           # verify the exact tag with `ollama list`
LLM_TIMEOUT_SECONDS=90

# ---- Reviewer sign-in ----
REVIEWER_PASSWORD_HASH=           # generate: cd backend && python -m app.auth hash-password
SESSION_SECRET=                   # long random string, e.g. python -c "import secrets;print(secrets.token_urlsafe(32))"

# ---- Storage ----
# Leave DATABASE_URL empty to use a local SQLite file (DATABASE_PATH). To use Supabase PostgreSQL,
# follow docs/SUPABASE_SETUP.md. Placeholders only: never commit real passwords.
DATABASE_URL=                     # backend login, e.g. postgresql://relieflens_backend.<project-ref>:<password>@<pooler-host>:5432/postgres
MIGRATION_DATABASE_URL=           # owner login, used only by `python -m app.migrate`: postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres
DATABASE_PATH=storage/relieflens.db
UPLOAD_DIR=storage/uploads

# ---- Map search (OpenStreetMap Nominatim) ----
GEOCODER_ENABLED=true
GOOGLE_MAPS_API_KEY=              # optional server key (Geocoding API); blank = OpenStreetMap
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=ReliefLens/0.1 (+https://github.com/alihaider-builds/Velnora)

# ---- Duplicates ----
DUP_MAX_KM=2
DUP_MAX_HOURS=24
DUP_MIN_SCORE=0.6

# ---- SMS / WhatsApp (optional; leave blank to use the simulator only) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VALIDATE_SIGNATURE=true
PUBLIC_BASE_URL=                  # public tunnel URL Twilio calls, e.g. https://xyz.trycloudflare.com

# SMS to your own SIM: "SMS Gateway for Android" (https://sms-gate.app) on the helpline phone
SMS_GATEWAY_SIGNING_KEY=          # same value as the app's Settings > Webhooks > Signing Key
SMS_GATEWAY_REPLY=false           # true: text the reference back to the sender from the helpline phone
SMS_GATEWAY_API_URL=https://api.sms-gate.app/3rdparty/v1
SMS_GATEWAY_USERNAME=             # app: Cloud Server username / password
SMS_GATEWAY_PASSWORD=
# SMS to your own SIM: textbee (https://textbee.dev) on the helpline phone
TEXTBEE_SIGNING_SECRET=           # 20+ random characters; the dashboard's Connect sends it to textbee
TEXTBEE_API_KEY=                  # textbee dashboard API key (optional here; can be typed in the dashboard)
TEXTBEE_REPLY=false               # true: text the reference back to the sender (needs TEXTBEE_API_KEY)
TUNNEL_INBOUND_ONLY=true          # through a Cloudflare tunnel, only /api/inbound/* webhooks are reachable
SENDER_HASH_SECRET=               # long random string
HELPLINE_EMERGENCY_NUMBER=1122

# ---- Helpline call transcription ----
TRANSCRIBER_BACKEND=fake          # fake (reviewer types transcripts) | gemma (pip install -e ".[audio]")
GEMMA_AUDIO_MODEL=google/gemma-4-E4B-it
TRANSCRIBE_LANGUAGE=Urdu          # or "auto"
MAX_CALL_SECONDS=300

# ---- Privacy, demo, limits ----
PUBLIC_COORD_DECIMALS=2
DEMO_MODE=true
CORS_ORIGINS=                     # only needed if the frontend is NOT served through the /api proxy
RATE_LIMIT_ENABLED=true
