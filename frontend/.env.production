# Production builds (`npm run build`) always use the real backend, even when .env.local enables
# mocks for development: Vite gives .env.production priority over .env.local.
# For a deliberate offline mock-demo build, override in .env.production.local (git-ignored) or
# the shell, e.g. `VITE_USE_MOCKS=true npm run build`.
VITE_USE_MOCKS=false
