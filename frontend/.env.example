# Copy to .env.local (not committed) and adjust.
# true = MSW mock backend in the browser; false = real backend (switch at Checkpoint C2).
VITE_USE_MOCKS=true
# Backend that the dev server proxies /api to (Laptop A's Wi-Fi IP during the hackathon).
VITE_API_TARGET=http://localhost:8000

